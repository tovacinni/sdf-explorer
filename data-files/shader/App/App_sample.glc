#version 410 or 430 // -*- c++ -*-
#ifdef GL_ARB_compute_variable_group_size
#extension GL_ARB_compute_variable_group_size : enable
#endif

#include <g3dmath.glsl>

// Both textures have one texel per sample. Lookups are offset to the texel
// centre so that rand(uv / size) reads texel uv exactly; a lookup on the
// texel edge can round into the neighbouring texel and give two samples the
// same random value.
uniform sampler2D uniformRandom3d;
#define rand(coord) texture(uniformRandom3d, (coord) + 0.5 / vec2(textureSize(uniformRandom3d, 0)))
uniform sampler2D gaussianRandom3d;
#define gaussian(coord) texture(gaussianRandom3d, (coord) + 0.5 / vec2(textureSize(gaussianRandom3d, 0)))

// First row of the sample grid covered by this dispatch.
uniform int rowOffset;
// Number of samples requested on the command line.
uniform int sampleCount;
// Smallest lattice resolution r with r^3 >= sampleCount.
uniform int gridResolution;

#include "App_raycast.glsl"

#include ACTIVE_SHADER

layout(local_size_variable) in;

layout(std430, binding = 0) restrict writeonly buffer DistanceSSBO {
    vec4 distance[];
};

layout(std430, binding = 1) restrict writeonly buffer NormalSSBO {
    vec4 normal[];
};

/** Mean Curvature of point p
  Based on https://www.shadertoy.com/view/Xts3WM
*/
float sdf_curv(Point3 p)
{
    vec3 e = vec3(1.0/32.0, 0, 0);

    float t1 = distanceToSurface(p + e.xyy), t2 = distanceToSurface(p - e.xyy);
    float t3 = distanceToSurface(p + e.yxy), t4 = distanceToSurface(p - e.yxy);
    float t5 = distanceToSurface(p + e.yyx), t6 = distanceToSurface(p - e.yyx);
    
    return .25/e.x*(t1 + t2 + t3 + t4 + t5 + t6 - 6.0*distanceToSurface(p));
}

vec4 sdf_normal(vec3 p) {
    const float minimumDistanceToSurface = 0.00003;
    const vec3 eps = vec3(minimumDistanceToSurface * 5.0, 0.0, 0.0);
    vec3 n = normalize(vec3(sdf_bounded(p + eps.xyz) - sdf_bounded(p - eps.xyz),
                            sdf_bounded(p + eps.yxz) - sdf_bounded(p - eps.yxz),
                            sdf_bounded(p + eps.zyx) - sdf_bounded(p - eps.zyx)));
    return vec4(n, sdf_bounded(p));
}

// Per-run seed from the CPU; different runs of the same pattern draw different numbers.
uniform uint randomSeed;

/** PCG3D hash (Jarzynski and Olano 2020, "Hash Functions for GPU Rendering"). */
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

/** Three uniform [0, 1) numbers that depend only on the sample's pixel, the
    run seed, and the draw counter, which this call advances. Unlike an
    iterated texture lookup, two samples never share a stream, so chains that
    draw many numbers (the metropolis samplers) stay independent. */
vec3 nextUniform(vec2 pixel, inout uint draw) {
    uvec3 h = pcg3d(uvec3(uint(pixel.x), uint(pixel.y), (draw * 0x9E3779B9u) ^ randomSeed));
    draw += 1u;
    return vec3(h >> 8u) * (1.0 / 16777216.0);
}

/** Three independent standard normal numbers (Box-Muller); advances draw by two. */
vec3 nextGaussian(vec2 pixel, inout uint draw) {
    vec3 a = nextUniform(pixel, draw);
    vec3 b = nextUniform(pixel, draw);
    return sqrt(-2.0 * log(max(a, vec3(1e-7)))) * cos(6.28318530718 * b);
}

/** True when p lies in the [-1, 1] cube that sdf_bounded clips the SDF to. */
bool insideSampleCube(vec3 p) {
    return all(lessThanEqual(abs(p), vec3(1.0)));
}

#include ACTIVE_SAMPLER

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.x, int(gl_GlobalInvocationID.y) + rowOffset);
    if ((pixel.x >= int(g3d_FragCoordExtent.x)) || (pixel.y >= int(g3d_FragCoordExtent.y))) {
        return;
    }
    int index = pixel.y * int(g3d_FragCoordExtent.x) + pixel.x;
    vec4 xyzd = sdf_sampler(vec2(pixel), int(g3d_FragCoordExtent.x));
    distance[index] = xyzd;
    normal[index] = sdf_normal(xyzd.xyz);
}

